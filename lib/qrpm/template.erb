Name: <%= name %>
Summary: <%= summary %>
Version: <%= version %>
Release: <%= release %>
License: <%= license %>
Packager: <%= packager %>
<% for pck in require || [] -%>
Requires: <%= pck %>
<% end -%>
Source: %{name}.tar.gz

%description
<%= description %>

%global debug_package %{nil}

%prep
%setup -n <%= name %>

%build
cd <%= srcdir %>
<% if make -%>
<%= make %>
<% end -%>

%install
<% if !nodes.empty? -%>
mkdir -p <%= nodes.map { |f| "%{buildroot}#{f.directory}" }.uniq.join(" ") %>
<% for file in files -%>
cp <%= file.srcpath %> %{buildroot}<%= file.dstpath %>
<% end -%>
<% for link in links -%>
touch %{buildroot}<%= link.dstpath %>
<% end -%>
<% end -%>

%files
<% for file in files -%>
<% if file.perm -%>
%attr(<%= file.perm %>,-,-) <%= file.dstpath %>
<% else -%>
<%= file.dstpath %>
<% end -%>
<% end -%>
<% for link in links -%>
%ghost <%= link.dstpath %>
<% end -%>

%clean
true # no-op

<% if pre -%>
%pre
<%= pre %>

<% end -%>
%post
<% for link in reflinks -%>
ln -f <%= link.reflink %> <%= link.dstpath %>
<% end -%>
<% for link in symlinks -%>
ln -sf <%= link.symlink %> <%= link.dstpath %>
<% end -%>
<% if post -%>
<%= post %>
<% end -%>
<% if pre_uninstall -%>

%preun
<%= pre_uninstall %>
<% end -%>
<% if post_uninstall -%>

%postun
<%= post_uninstall %>
<% end -%>
